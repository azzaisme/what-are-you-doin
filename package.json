{
    "name": "uncivil-engineers",
    "version": "0.0.0",
    "private": true,
    "description": "A PlayCanvas TypeScript project",
    "type": "module",
    "scripts": {
    "build": "vite build",
    "build:publish": "vite build -c vite.publish.config.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "dev": "vite --open",
    "fmt": "prettier --check .",
    "fmt:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "vite preview --open",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
    "dependencies": {
        "playcanvas": "^2.24.1"
    },
    "devDependencies": {
        "@playcanvas/eslint-config": "3.0.0",
        "@playcanvas/inspector": "^0.5.0",
        "@playwright/test": "^1.65.1",
        "@types/pngjs": "^6.0.5",
        "eslint": "^9.39.5",
        "pngjs": "^7.0.0",
        "prettier": "^3.10.1",
        "typescript": "~6.0.3",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    },
    "engines": {
        "node": ">=22.23.2"
    }
}
